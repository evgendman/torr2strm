# torr2strm v1.3.2
# Two independent materialized trees are generated from one TorrServer source.
# Jellyfin keeps the existing default root below; Kodi/Elementum gets a second root.

[torrserver]
url = "http://127.0.0.1:8097"
timeout_sec = 20
remove_timeout_sec = 60
metadata_wait_sec = 10
metadata_poll_sec = 0.5

[outputs.jellyfin]
# Existing Jellyfin libraries can continue using this root.
root = "/mnt/torr2strm-media"
manifest = ".torr2strm/manifest.json"
enabled = true

# Jellyfin is the only authoritative/read-write output. If true and a managed
# Jellyfin STRM is deleted by the user, the source torrent is permanently
# removed from TorrServer with action=rem. Never use action=drop.
remove_torrent_on_strm_delete = false
max_torrent_removals_per_run = 1

[outputs.kodi]
# Separate read-only Kodi/Elementum materialized tree.
root = "/mnt/torr2strm-media-kodi"
manifest = ".torr2strm/manifest.json"
enabled = true

[sync]
# Season used when a TV episode cannot be inferred from its file path/title.
# 0 maps to Jellyfin/Kodi Specials semantics.
tv_unmatched_season = 0

# These are video extensions only. Audio/subtitle/image files never get STRM files.
video_extensions = [
  ".mkv", ".mp4", ".m4v", ".avi", ".mov", ".wmv", ".webm",
  ".ts", ".m2ts", ".mts", ".mpeg", ".mpg", ".mxf", ".flv",
  ".vob", ".3gp", ".ogv", ".ogm", ".rm", ".rmvb", ".divx",
  ".asf", ".asx", ".f4v", ".m2v", ".m2t", ".tp", ".ty", ".wtv"
]

[quality]
# torr2strm calls TorrServer GET /ffp/{hash}/{file_id}; it does not launch ffprobe itself.
# Ensure ffprobe is available on the TorrServer host. 2160-class -> 4K; otherwise -> 1080p.
timeout_sec = 12
retries = 0

[jacred]
# The URL is a service base URL, not a release-page URL; code appends /api/v1/search.
# A candidate result is accepted only when its BTIH/infoHash exactly matches TorrServer.
# The exact result may supply category, ffprobe JSON, magnet URL and provider IDs.
# The public jac.red instance used in our tests; an empty URL disables enrichment.
url = "https://jac.red"
api_key = ""
indexer_id = 1
limit = 100
timeout_sec = 10
retries = 0

[logging]
level = "INFO"
